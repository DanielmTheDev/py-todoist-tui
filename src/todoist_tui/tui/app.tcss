/* Chrome for the main screen. The text-emphasis ramp itself lives in
   `theme.TIER_CSS`, carried by each tiered widget. */

/* A tint, not a slab: enough to read as chrome rather than content, and the
   $text* ramp resolves over it so the band keeps its own hierarchy. */
#status {
    background: $primary 12%;
    padding: 0 $gutter;
    height: 1;
    /* error text is arbitrary; clip it rather than let the chrome wrap */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* A tint the cells show through, not a slab that repaints them — paired with
   cursor_foreground_priority = "renderable", so the row under the cursor keeps
   its own text hierarchy. */
TaskTable > .datatable--cursor {
    background: $primary 20%;
}

/* Column headers name the data; they must not compete with it. */
TaskTable > .datatable--header {
    background: $surface;
    color: $text-disabled;
    text-style: not bold;
}
