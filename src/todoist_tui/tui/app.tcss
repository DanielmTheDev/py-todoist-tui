/* Chrome for the main screen. The palette itself lives in `theme.PALETTE_CSS`,
   carried by each palette-aware widget.

   Sections are told apart by full-width rules, not by background tints: stacked
   bands read as noise, and a rule that runs edge to edge lines up with the group
   dividers inside the table. */

/* A list is a column of text, not a banner: past ~120 cells the eye loses the
   line back to the next one, and the last column's stretch becomes a gap. */
Screen {
    align-horizontal: center;
}

StatusBand, ColumnHeader, TaskTable, Rule {
    width: 100%;
    max-width: 120;
}

#status, #columns {
    background: transparent;
    height: 1;
    /* error text is arbitrary; clip it rather than let the chrome wrap */
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

Rule.-horizontal {
    color: $text-disabled;
    margin: 0;  /* the default vertical margin would strand the rule mid-gap */
}

TaskTable {
    /* the table's own surface would end in a hard edge under the last row */
    background: transparent;
}

/* A tint the cells show through, not a slab that repaints them — paired with
   cursor_foreground_priority = "renderable", so the row under the cursor keeps
   its own text hierarchy. */
TaskTable > .datatable--cursor {
    background: $primary 20%;
}
